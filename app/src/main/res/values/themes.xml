<resources>
    <style name="Theme.Gilkok" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/road_teal</item>
        <item name="colorPrimaryVariant">@color/road_teal_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/road_gold</item>
        <item name="colorOnSecondary">@color/road_navy</item>
        <item name="colorSurface">@color/road_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:colorBackground">@color/road_navy</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/road_muted</item>
        <item name="android:statusBarColor">@color/road_rail</item>
        <item name="android:navigationBarColor">@color/road_rail</item>
        <item name="materialButtonStyle">@style/Widget.Gilkok.Button</item>
    </style>
    <style name="Widget.Gilkok.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.Gilkok.Button.Secondary">
        <item name="backgroundTint">@color/road_surface2</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="Widget.Gilkok.Button.Nav">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/road_muted</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">80dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Gilkok.Title" parent=""><item name="android:textSize">28sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/white</item></style>
    <style name="Gilkok.Label" parent=""><item name="android:textSize">16sp</item><item name="android:textColor">@color/road_muted</item><item name="android:layout_marginTop">20dp</item><item name="android:layout_marginBottom">8dp</item></style>
    <style name="Gilkok.Body" parent=""><item name="android:textSize">20sp</item><item name="android:textColor">@color/white</item><item name="android:lineSpacingExtra">4dp</item></style>
    <style name="Gilkok.Card" parent=""><item name="android:background">@drawable/card_bg</item><item name="android:padding">24dp</item><item name="android:orientation">vertical</item></style>
</resources>
